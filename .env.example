# PBX / SIP
ASTERISK_HOST=10.29.32.138
REMOTE_SIP_PORT=5060
LOCAL_SIP_PORT=5062
MEDIA_RTP_PORT=4000
MEDIA_RTP_PORT_RANGE=400

# Test caller
CALLER_USER=1001
CALLER_PASS=replace_me
CALLER_DISPLAY=Automation Test
DEST_NUMBER=replace_me

# AMI is required to prove that Jane did not transfer to GSR.
USE_AMI_READY_EVENTS=1
AMI_HOST=10.29.32.138
AMI_PORT=5038
AMI_USER=replace_me
AMI_SECRET=replace_me
AMI_READY_EVENT_NAME=TestReadyForInput
AMI_EVENT_CALLER=
AMI_TRACE_EVENTS=1
AMI_DETECT_TRANSFER=1
AMI_TRANSFER_CONTEXT_PREFIXES=transfer-
# Comma-separated AMI Dial targets that identify GSR at this site.
# Keep GSR and replace/add the exact trunk/channel token supplied by the PBX owner.
AMI_TRANSFER_DIAL_TARGETS=GSR,@CUCM_Trunk
# Stage classifiers for structured caller-ID logs. Replace/add the real AMI
# context, channel, extension, or application tokens used in this PBX.
AMI_ORBITI_MATCH=orbiti
AMI_JANE_MATCH=jane,5100
AMI_TRANSFER_MATCH=transfer
HANGUP_ON_AMI_TRANSFER=1

# Runtime safety
CALL_START_GAP_MS=200
MAX_CALL_SECONDS=1800
